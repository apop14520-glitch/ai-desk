# Copy to .env (git-ignored) and fill in. Never commit the real file.

# OpenAI — pay-as-you-go. Set a hard spend limit on the key in the dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google — AI Studio key. The free tier may use your prompts to improve
# Google products, so keep sensitive questions off it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic — agent_sdk draws on the Claude plan's monthly credit (no key
# needed, sign in with the Claude CLI). Set to "api" to use ANTHROPIC_API_KEY.
ANTHROPIC_VIA=agent_sdk
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
